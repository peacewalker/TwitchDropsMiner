FROM python:3.12-alpine3.23 AS builder
RUN apk add --no-cache build-base libffi-dev openssl-dev binutils
WORKDIR /app
COPY requirements.txt requirements-lite.txt ./
RUN python -m venv env \
    && env/bin/pip install --no-cache-dir -r requirements-lite.txt 'pyinstaller>=6,<7' setuptools
COPY . .
ENV UI_BACKEND=nicegui WEBUI_TWITCH_LOGIN=cookie-only
RUN env/bin/pyinstaller --clean --noconfirm build.spec

FROM alpine:3.23
ARG UPSTREAM_SHA=unknown
ARG WEBUI_SHA=unknown
LABEL org.opencontainers.image.title="Twitch Drops Miner WebUI Lite" \
      org.opencontainers.image.source="https://github.com/fireph/TwitchDropsMiner" \
      org.opencontainers.image.revision="${WEBUI_SHA}" \
      io.twitchdropsminer.upstream-revision="${UPSTREAM_SHA}"
ENV UI_BACKEND=nicegui \
    WEBUI_HOST=0.0.0.0 WEBUI_PORT=5800 WEBUI_TWITCH_LOGIN=cookie-only \
    USER_ID=1000 GROUP_ID=1000
RUN apk add --no-cache ca-certificates tzdata su-exec openssl curl libstdc++ libgcc brotli-libs
WORKDIR /TwitchDropsMiner
COPY --from=builder --chown=1000:1000 --chmod=755 ["/app/dist/Twitch Drops Miner (by DevilXD)", "/TwitchDropsMiner/TwitchDropsMiner"]
COPY --chmod=755 docker/entrypoint-lite.sh /entrypoint.sh
RUN mkdir -p config cache && chown 1000:1000 /TwitchDropsMiner config cache
EXPOSE 5800
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD sh -c 'protocol=http; [ "${SECURE_CONNECTION:-0}" = "1" ] && protocol=https; curl -kfs --max-time 8 -o /dev/null "${protocol}://127.0.0.1:${WEBUI_PORT:-5800}/health"'
ENTRYPOINT ["/entrypoint.sh"]
